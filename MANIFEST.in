include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include GOVERNANCE.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml
recursive-include docs *.md *.txt
exclude docs/release/v0.1.0-rc1-validation.md
exclude docs/release/v0.1.0-rc2-validation.md
recursive-include requirements *.in *.lock
recursive-include scripts *.py
recursive-include tests *.py
prune docs/archive/prompts
global-exclude __pycache__ *.py[cod] .DS_Store
